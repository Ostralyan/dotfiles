{{/*
   Asked once, on `chezmoi init`. Answers are stored in
   ~/.config/chezmoi/chezmoi.toml, which is never committed.
*/ -}}

{{- $name    := promptStringOnce . "name"  "Full name for git commits" -}}
{{- $email   := promptStringOnce . "email" "Email for git commits" -}}
{{- $personal := promptBoolOnce . "personal" "Install the personal macOS rig (aerospace + sketchybar + karabiner + harp)" false -}}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    personal = {{ $personal }}
